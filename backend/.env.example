# ===== Backend =====
NODE_ENV=development
PORT=5000

# ===== Database =====
# Хост: localhost. В Docker compose переменная переопределяется на @postgres:5432.
DATABASE_URL=postgresql://sbl:sbl_dev_pw@localhost:5432/star_beaver_lab

# ===== JWT =====
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d

# ===== Uploads =====
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50