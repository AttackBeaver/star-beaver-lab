// ============================================================
// Star Beaver Lab — схема БД
// Стек: PostgreSQL 16, Prisma 6 (migrate, НЕ push)
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ============================================================
// Роли
// USER      — обычный пользователь (регистрация по умолчанию)
// MODERATOR — модерация мемов/новостей, чистка контента
// OWNER     — разработчик, полный доступ
// ============================================================
enum Role {
  USER
  MODERATOR
  OWNER
}

// ============================================================
// Тип медиа для мемов (блок 2)
// IMAGE — jpg/png/gif/webp
// VIDEO — mp4/webm (постер — первый кадр через ffmpeg)
// ============================================================
enum MediaType {
  IMAGE
  VIDEO
}

// ============================================================
// Пользователь
// ============================================================
model User {
  id Int @id @default(autoincrement())

  // email обязателен: защита от мультиаккаунтов даже без верификации —
  // нельзя дважды зарегистрироваться с одним адресом.
  // Верификация письмом — отдельный блок, здесь только уникальность в БД.
  email String @unique

  // username опционален: отображаемое имя в профиле.
  // Пользователь может задать позже, если не задал при регистрации.
  username String? @unique

  fullName     String
  passwordHash String
  role         Role   @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  // ===== Связи =====
  logs         Log[]      @relation("UserLogs")
  // Блок 2 — мемы
  memes        Meme[]     @relation("MemeAuthor")
  memesDeleted Meme[]     @relation("MemeDeletedBy")
  memeLikes    MemeLike[]

  @@index([role])
  @@index([createdAt])
}

// ============================================================
// Аудит-логи
// Пишутся с первого запроса (middleware auditLog + logAction()).
// При удалении пользователя логи сохраняются: userId → null.
// ============================================================
model Log {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation("UserLogs", fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// Мемы (блок 2)
// - soft-delete: deletedAt/deletedById, файл остаётся на диске
// - mediaType: IMAGE | VIDEO
// - posterPath: первый кадр видео (ffmpeg), null для IMAGE и при сбое
// - filePath относительно backend/ ("uploads/memes/2026/11/<uuid>.mp4")
//   абсолютный путь собирается в контроллере: path.join(process.cwd(), filePath)
// ============================================================
model Meme {
  id          Int     @id @default(autoincrement())
  title       String? @db.VarChar(200)
  description String? @db.VarChar(2000)

  // ===== Файл =====
  filePath     String    @db.VarChar(500)
  fileName     String    @db.VarChar(255) // "<uuid>.mp4" — для Content-Disposition
  originalName String    @db.VarChar(255) // как загрузил пользователь — для UI
  mimeType     String    @db.VarChar(100)
  sizeBytes    Int
  mediaType    MediaType
  posterPath   String?   @db.VarChar(500) // "uploads/memes/2026/11/<uuid>_poster.jpg"

  // ===== Автор =====
  authorId Int
  author   User @relation("MemeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===== Soft-delete =====
  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?     @relation("MemeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // ===== Лайки =====
  likes MemeLike[]

  @@index([authorId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([deletedAt, createdAt])
}

// ============================================================
// Лайки мемов (блок 2)
// Один пользователь — один лайк на мем (unique).
// ============================================================
model MemeLike {
  id        Int      @id @default(autoincrement())
  memeId    Int
  meme      Meme     @relation(fields: [memeId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([memeId, userId])
  @@index([memeId])
  @@index([userId])
}
